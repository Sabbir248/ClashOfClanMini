<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    Dashboard Screen Layout
    Controller: com.clashgame.client.controller.DashboardController
    
    Layout:
    ┌──────────────────────────────────────────┐
    │  [Player Info]     [Gold] [Elixir] [Gems]│  ← Top resource bar
    ├──────────────────────────────────────────┤
    │                                          │
    │    ┌──────────┐  ┌──────────┐            │
    │    │ 🏰 View  │  │ ⚔ Attack │           │
    │    │   Base   │  │  Player  │            │
    │    └──────────┘  └──────────┘            │
    │                                          │
    │    ┌──────────┐  ┌──────────┐            │
    │    │ 🗡 Train │  │ 🏆 Leader│           │
    │    │  Units   │  │   board  │            │
    │    └──────────┘  └──────────┘            │
    │                                          │
    │              [Logout]                    │
    └──────────────────────────────────────────┘
-->

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.clashgame.client.controller.DashboardController"
            prefWidth="800" prefHeight="600"
            styleClass="game-bg"
            stylesheets="@../css/game_style.css">

    <!-- Top: Resource Bar -->
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="top-bar">
            <HBox spacing="5" alignment="CENTER">
                <Label fx:id="usernameLabel" text="Player"
                       styleClass="label-resource"/>
                <Label fx:id="levelLabel" text="Level: 1"
                       style="-fx-text-fill: #3498db; -fx-font-size: 14;"/>
                <Label fx:id="xpLabel" text="XP: 0/100"
                       style="-fx-text-fill: #2ecc71; -fx-font-size: 12;"/>
                <Label fx:id="trophyLabel" text="Trophies: 0"
                       style="-fx-text-fill: gold; -fx-font-size: 14;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Resources -->
            <HBox spacing="15" alignment="CENTER">
                <HBox spacing="3" alignment="CENTER">
                    <Label text="🪙" style="-fx-font-size: 16;"/>
                    <Label fx:id="goldLabel" text="500"
                           style="-fx-text-fill: gold; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label fx:id="goldCapLabel" text="/ 5000"
                           style="-fx-text-fill: #888; -fx-font-size: 11;"/>
                </HBox>
                <HBox spacing="3" alignment="CENTER">
                    <Label text="💧" style="-fx-font-size: 16;"/>
                    <Label fx:id="elixirLabel" text="500"
                           style="-fx-text-fill: #9b59b6; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label fx:id="elixirCapLabel" text="/ 5000"
                           style="-fx-text-fill: #888; -fx-font-size: 11;"/>
                </HBox>
                <HBox spacing="3" alignment="CENTER">
                    <Label text="💎" style="-fx-font-size: 16;"/>
                    <Label fx:id="gemsLabel" text="50"
                           style="-fx-text-fill: #2ecc71; -fx-font-size: 14; -fx-font-weight: bold;"/>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <!-- Center: Main Menu Grid -->
    <center>
        <HBox spacing="0">
            <VBox alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <Label text="Command Center"
                       style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;"/>

                <!-- Action Buttons Grid -->
                <GridPane hgap="20" vgap="20" alignment="CENTER">
                    <!-- Row 0 -->
                    <Button fx:id="viewBaseButton" text="🏰 View Base"
                            onAction="#onViewBaseClicked"
                            GridPane.columnIndex="0" GridPane.rowIndex="0"
                            styleClass="button-success"
                            style="-fx-font-size: 16; -fx-pref-width: 200; -fx-pref-height: 80;
                                   -fx-background-radius: 10; -fx-cursor: hand;">
                        <tooltip><Tooltip text="View and edit your village base layout"/></tooltip>
                    </Button>

                    <Button fx:id="attackButton" text="⚔ Attack Player"
                            onAction="#onAttackClicked"
                            GridPane.columnIndex="1" GridPane.rowIndex="0"
                            styleClass="button-attack"
                            style="-fx-font-size: 16; -fx-pref-width: 200; -fx-pref-height: 80;
                                   -fx-background-radius: 10; -fx-cursor: hand;">
                        <tooltip><Tooltip text="Search for an opponent and attack their base"/></tooltip>
                    </Button>

                    <!-- Row 1 -->
                    <Button fx:id="trainButton" text="🗡 Train Units"
                            onAction="#onTrainClicked"
                            GridPane.columnIndex="0" GridPane.rowIndex="1"
                            styleClass="button-train"
                            style="-fx-font-size: 16; -fx-pref-width: 200; -fx-pref-height: 80;
                                   -fx-background-radius: 10; -fx-cursor: hand;">
                        <tooltip><Tooltip text="Train troops in your barracks to build your army"/></tooltip>
                    </Button>

                    <Button fx:id="leaderboardButton" text="🏆 Leaderboard"
                            onAction="#onLeaderboardClicked"
                            GridPane.columnIndex="1" GridPane.rowIndex="1"
                            styleClass="button-leaderboard"
                            style="-fx-font-size: 16; -fx-pref-width: 200; -fx-pref-height: 80;
                                   -fx-background-radius: 10; -fx-cursor: hand;">
                        <tooltip><Tooltip text="View the global player rankings by trophies"/></tooltip>
                    </Button>

                    <!-- Row 2 -->
                    <Button fx:id="battleHistoryButton" text="📜 Battle History"
                            onAction="#onBattleHistoryClicked"
                            GridPane.columnIndex="0" GridPane.rowIndex="2"
                            style="-fx-font-size: 16; -fx-pref-width: 200; -fx-pref-height: 80;
                                   -fx-background-radius: 10; -fx-cursor: hand;
                                   -fx-background-color: #2c3e50; -fx-text-fill: white;">
                        <tooltip><Tooltip text="View your recent battle results"/></tooltip>
                    </Button>

                    <Button fx:id="laboratoryButton" text="🧪 Laboratory"
                            onAction="#onLaboratoryClicked"
                            GridPane.columnIndex="1" GridPane.rowIndex="2"
                            styleClass="button-laboratory"
                            style="-fx-font-size: 16; -fx-pref-width: 200; -fx-pref-height: 80;
                                   -fx-background-radius: 10; -fx-cursor: hand;">
                        <tooltip><Tooltip text="Upgrade your troops in the Laboratory"/></tooltip>
                    </Button>
                </GridPane>

                <Region prefHeight="20"/>

                <!-- Army Info -->
                <Label fx:id="armySizeLabel" text="Army: 0 / 30 units"
                       style="-fx-text-fill: #bdc3c7; -fx-font-size: 14;"/>

                <Button fx:id="logoutButton" text="Logout"
                        onAction="#onLogoutClicked"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                               -fx-font-size: 12; -fx-pref-width: 120;
                               -fx-background-radius: 5; -fx-cursor: hand;"/>
            </VBox>

            <!-- Right: Chat Panel -->
            <fx:include source="chat_panel.fxml"/>
        </HBox>
    </center>
</BorderPane>
