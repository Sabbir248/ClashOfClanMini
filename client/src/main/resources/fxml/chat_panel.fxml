<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    Chat Panel (embeddable component)
    Controller: com.clashgame.client.controller.ChatController
-->

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.clashgame.client.controller.ChatController"
      spacing="8" prefWidth="300" prefHeight="400"
      styleClass="chat-panel">

    <Label text="💬 Global Chat"
           style="-fx-text-fill: #3498db; -fx-font-size: 14; -fx-font-weight: bold;"/>

    <ListView fx:id="chatListView" VBox.vgrow="ALWAYS"
              style="-fx-background-color: #2c3e50;"/>

    <HBox spacing="8">
        <TextField fx:id="chatInput" HBox.hgrow="ALWAYS"
                   promptText="Type a message..."
                   onAction="#onChatInputAction"
                   style="-fx-font-size: 12;"/>
        <Button fx:id="sendButton" text="Send" onAction="#onSendClicked"
                style="-fx-background-color: #3498db; -fx-text-fill: white;
                       -fx-font-size: 12; -fx-cursor: hand;"/>
    </HBox>
</VBox>
